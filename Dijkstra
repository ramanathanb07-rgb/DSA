#include <stdio.h>

#define MAX 20
#define INF 9999

int main()
{
    int cost[MAX][MAX];
    int distance[MAX], visited[MAX];
    int n, source;
    int i, j, count, min, next;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    if (n < 1 || n > MAX)
    {
        printf("Invalid number of vertices\n");
        return 1;
    }

    printf("Enter cost adjacency matrix:\n");
    printf("Enter 0 for no edge (except diagonal):\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);

            if (i != j && cost[i][j] == 0)
                cost[i][j] = INF;
        }
    }

    printf("Enter source vertex (0 to %d): ", n - 1);
    scanf("%d", &source);

    if (source < 0 || source >= n)
    {
        printf("Invalid source vertex\n");
        return 1;
    }

    for (i = 0; i < n; i++)
    {
        distance[i] = cost[source][i];
        visited[i] = 0;
    }

    distance[source] = 0;
    visited[source] = 1;

    for (count = 1; count < n; count++)
    {
        min = INF;
        next = -1;

        for (i = 0; i < n; i++)
        {
            if (!visited[i] && distance[i] < min)
            {
                min = distance[i];
                next = i;
            }
        }

        if (next == -1)
            break;

        visited[next] = 1;

        for (i = 0; i < n; i++)
        {
            if (!visited[i] &&
                cost[next][i] != INF &&
                distance[next] + cost[next][i] < distance[i])
            {
                distance[i] =
                    distance[next] + cost[next][i];
            }
        }
    }

    printf("\nShortest distances from vertex %d:\n", source);

    for (i = 0; i < n; i++)
    {
        if (distance[i] == INF)
            printf("To %d = Unreachable\n", i);
        else
            printf("To %d = %d\n", i, distance[i]);
    }

    return 0;
}
