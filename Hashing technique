#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

int hashFunction(int key)
{
    return key % SIZE;
}

void insert(int key)
{
    int index = hashFunction(key);

    while (hashTable[index] != -1)
    {
        index = (index + 1) % SIZE;
    }

    hashTable[index] = key;
}

void display()
{
    int i;

    printf("\nHash Table:\n");

    for (i = 0; i < SIZE; i++)
    {
        if (hashTable[i] == -1)
            printf("%d : Empty\n", i);
        else
            printf("%d : %d\n", i, hashTable[i]);
    }
}

int main()
{
    int i, key;
    int keys[] = {23, 43, 13, 27, 37};

    for (i = 0; i < SIZE; i++)
        hashTable[i] = -1;

    for (i = 0; i < 5; i++)
        insert(keys[i]);

    display();

    return 0;
}
